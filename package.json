{
  "name": "wabrix",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "video:dev": "pnpm --filter @wabrix/video dev",
    "video:render": "pnpm --filter @wabrix/video render",
    "video:upload": "pnpm --filter @wabrix/video upload",
    "taste:copy-lint": "node .agents/skills/design-taste-frontend/scripts/copy-lint.mjs apps/web-2/src/components/landing-page/ui/*.tsx \"apps/web-2/src/app/(public)/page.tsx\" --kind software",
    "taste:gate": "node .agents/skills/design-taste-frontend/scripts/gate.mjs"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "csstype": "3.2.3",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1"
  }
}
